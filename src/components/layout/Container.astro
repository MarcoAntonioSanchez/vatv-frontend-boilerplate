
---
/*
 * PROPS DEL COMPONENTE
 *
 * Definimos las propiedades que puede recibir Container.
 * Astro utilizará esta interfaz para comprobar los tipos
 * durante el desarrollo.
 */
interface Props {
  // Clases CSS adicionales que se aplicarán al contenedor.
  class?: string;

  /*
   * Tamaño máximo del contenedor.
   *
   * Utilizamos una unión de literales de TypeScript para
   * limitar las opciones a los cinco tamaños definidos.
   */
  size?: "sm" | "md" | "lg" | "xl" | "2xl";
}

/*
 * RECUPERACIÓN DE PROPIEDADES
 *
 * Extraemos:
 * - class: clases adicionales.
 * - size: tamaño seleccionado, 2xl por defecto.
 * - attributes: cualquier otra propiedad HTML recibida.
 */
const {
  class: className,
  size = "2xl",
  ...attributes
} = Astro.props;

/*
 * CONFIGURACIÓN DE ANCHOS
 *
 * Relacionamos cada tamaño disponible con una clase de Tailwind.
 *
 * "as const" permite que TypeScript conserve los valores
 * literales de este objeto en lugar de generalizarlos a string.
 *
 * Todas las clases están escritas literalmente para que
 * Tailwind CSS pueda detectarlas durante la compilación.
 */
const sizeClasses = {
  sm: "max-w-3xl",
  md: "max-w-4xl",
  lg: "max-w-5xl",
  xl: "max-w-6xl",
  "2xl": "max-w-7xl",
} as const;
---

<!--
  CONTENEDOR PRINCIPAL

  class:list combina:
  1. Las clases estructurales comunes.
  2. El ancho máximo seleccionado.
  3. Las clases personalizadas recibidas.

  {...attributes} distribuye los atributos HTML adicionales.
-->
<div
  class:list={[
    "mx-auto w-full px-4 sm:px-6 lg:px-8",
    sizeClasses[size],
    className
  ]}
  {...attributes}
>
  <!--
    SLOT:
    Aquí Astro inserta el contenido que envuelve
    al componente Container.
  -->
  <slot />
</div>
