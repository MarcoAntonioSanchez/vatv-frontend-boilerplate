---
import { getCollection, render } from "astro:content";

// Recupera los artículos publicados.
const posts = await getCollection("blog", ({ data }) => {
  return !data.draft;
});

// Prepara el contenido Markdown para su renderizado.
const renderedPosts = await Promise.all(
  posts.map(async (post) => ({
    post,
    rendered: await render(post),
  })),
);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog | VTAV</title>
  </head>

  <body>
    <main>
      <h1>Blog</h1>

      {renderedPosts.map(({ post, rendered }) => (
        <article>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>

          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("es-MX")}
          </time>

          <hr />

          <div>
            <rendered.Content />
          </div>
        </article>
      ))}
    </main>
  </body>
</html>
