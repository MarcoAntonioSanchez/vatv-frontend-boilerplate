---
/*
 * IMPORTACIÓN DE COMPONENTES
 *
 * Container es nuestro componente reutilizable para controlar
 * el ancho máximo y la alineación horizontal del contenido.
 */
import Container from "../components/layout/Container.astro";

/*
 * ESTILOS GLOBALES
 *
 * Incluye Tailwind CSS v4, tokens tipográficos y fuentes locales.
 */
import "../styles/global.css";
---

<!-- ============================================================
     SECCIÓN 01: PRESENTACIÓN DEL BOILERPLATE
     ============================================================ -->

<section class="bg-slate-100">

  <Container class="space-y-8 py-16 sm:py-24">

    <!-- Encabezado de la demostración -->
    <header class="space-y-4">

      <!-- Identificador técnico -->
      <p class="font-accent text-sm font-medium uppercase tracking-widest text-slate-600">
        V.T.A.V. - Frontend Boilerplate
      </p>

      <!-- Título principal -->
      <h1 class="font-heading text-4xl font-bold tracking-tight text-slate-950 text-balance sm:text-5xl">
        Construyendo una base reutilizable
      </h1>

      <!-- Descripción -->
      <p class="max-w-2xl font-body text-lg leading-relaxed text-slate-700">
        Una arquitectura frontend modular con Astro, Tailwind CSS
        y tokens de diseño para futuros proyectos web.
      </p>

    </header>

    <!-- Tarjeta de demostración -->
    <div class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">

      <h2 class="font-heading text-2xl font-bold text-slate-900">
        Nuestro primer Container
      </h2>

      <p class="mt-3 font-body leading-relaxed text-slate-600">
        El contenido está centrado y limitado por el ancho máximo
        del componente. El padding lateral se adapta al viewport.
      </p>

      <!-- Etiquetas técnicas -->
      <div class="mt-6 flex flex-wrap gap-3">

        <span class="rounded-full bg-slate-100 px-3 py-1 font-accent text-xs text-slate-700">
          Astro
        </span>

        <span class="rounded-full bg-slate-100 px-3 py-1 font-accent text-xs text-slate-700">
          Tailwind CSS v4
        </span>

        <span class="rounded-full bg-slate-100 px-3 py-1 font-accent text-xs text-slate-700">
          Design tokens
        </span>

      </div>

    </div>

  </Container>

</section>


<!-- ============================================================
     SECCIÓN 02: SISTEMA TIPOGRÁFICO
     ============================================================ -->

<section class="bg-slate-100">

  <Container class="space-y-8 py-16 sm:py-24">

    <!-- Encabezado de la demostración -->
    <header class="space-y-4">

      <!-- Identificador técnico -->
      <p class="font-accent text-sm font-medium uppercase tracking-widest text-slate-600">
        VTAV Frontend / Design System
      </p>

      <!-- Título principal -->
      <h2 class="font-heading text-4xl font-bold tracking-tight text-slate-950 text-balance sm:text-5xl">
        Tres fuentes, una identidad.
      </h2>

      <!-- Descripción -->
      <p class="max-w-2xl font-body text-lg leading-relaxed text-slate-700">
        Una base tipográfica reutilizable para construir interfaces web consistentes,
        accesibles y fáciles de mantener.
      </p>

    </header>

    <!-- Tarjeta de demostración tipográfica -->
    <div class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">

      <!-- Grid de las tres familias tipográficas -->
      <div class="grid gap-6 md:grid-cols-3">

        <!-- ==================================================
             01. HEADING / UBUNTU
             ================================================== -->
        <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">

          <p class="mb-4 font-accent text-xs uppercase tracking-wider text-slate-600">
            01 / Heading
          </p>

          <h3 class="font-heading text-2xl font-bold text-slate-900">
            Ubuntu
          </h3>

          <p class="mt-3 font-body text-sm leading-6 text-slate-600">
            Medium y Bold para títulos, subtítulos y jerarquías visuales.
          </p>

          <!-- Pesos disponibles -->
          <p class="mt-6 font-heading font-medium text-slate-900">
            Medium 500
          </p>

          <p class="mt-2 font-heading font-bold text-slate-900">
            Bold 700
          </p>

        </article>


        <!-- ==================================================
             02. BODY / INTER
             ================================================== -->
        <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">

          <p class="mb-4 font-accent text-xs uppercase tracking-wider text-slate-600">
            02 / Body
          </p>

          <h3 class="font-body text-2xl font-bold text-slate-900">
            Inter Variable
          </h3>

          <p class="mt-3 font-body text-sm leading-6 text-slate-600">
            Una familia variable para párrafos, descripciones y contenido general.
          </p>

          <!-- Pesos disponibles -->
          <p class="mt-6 font-body font-normal text-slate-900">
            Regular 400
          </p>

          <p class="mt-2 font-body font-medium text-slate-900">
            Medium 500
          </p>

          <p class="mt-2 font-body font-bold text-slate-900">
            Bold 700
          </p>

        </article>


        <!-- ==================================================
             03. ACCENT / JETBRAINS MONO
             ================================================== -->
        <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">

          <p class="mb-4 font-accent text-xs uppercase tracking-wider text-slate-600">
            03 / Accent
          </p>

          <h3 class="font-accent text-xl font-bold text-slate-900">
            JetBrains Mono
          </h3>

          <p class="mt-3 font-body text-sm leading-6 text-slate-600">
            Una fuente monoespaciada para etiquetas, metadatos y detalles técnicos.
          </p>

          <!-- Ejemplos de etiquetas -->
          <div class="mt-6 flex flex-wrap gap-2">

            <span class="rounded-md border border-slate-300 bg-white px-3 py-1 font-accent text-xs text-slate-700">
              BETA
            </span>

            <span class="rounded-md border border-slate-300 bg-white px-3 py-1 font-accent text-xs text-slate-700">
              v1.0.0
            </span>

          </div>

          <!-- Caracteres de prueba -->
          <p class="mt-4 font-accent text-sm text-slate-700">
            0123456789 / &#123; &#125; / &lt;/&gt;
          </p>

        </article>

      </div>

      <!-- Pie de la demostración -->
      <footer class="mt-8 border-t border-slate-200 pt-6">

        <p class="font-body text-sm text-slate-500">
          Prueba tipográfica · Astro + Tailwind CSS v4
        </p>

      </footer>

    </div>

  </Container>

</section>


<!-- ============================================================
     SECCIÓN 03: CONTAINER / TAMAÑOS CONFIGURABLES
     ============================================================ -->

<section class="bg-slate-100">

  <Container class="space-y-8 py-16 sm:py-24">

    <!-- Encabezado de la demostración -->
    <header class="space-y-4">

      <!-- Identificador técnico -->
      <p class="font-accent text-sm font-medium uppercase tracking-widest text-slate-600">
        VTAV Frontend / Layout Components
      </p>

      <!-- Título principal -->
      <h2 class="font-heading text-4xl font-bold tracking-tight text-slate-950 text-balance sm:text-5xl">
        Un contenedor, múltiples posibilidades.
      </h2>

      <!-- Descripción -->
      <p class="max-w-2xl font-body text-lg leading-relaxed text-slate-700">
        Container permite establecer diferentes anchos máximos para
        organizar el contenido de cada proyecto, manteniendo el centrado
        y el padding responsive.
      </p>

    </header>


    <!-- Tarjeta principal de demostración -->
    <div class="space-y-6 rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">

      <!-- ==================================================
           01. SIZE SM
           ================================================== -->
      <article class="space-y-3">

        <header>
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            01 / Container size="sm"
          </p>

          <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
            Small · 48rem
          </h3>

          <p class="mt-1 font-body text-sm text-slate-600">
            max-w-3xl · Ideal para contenido estrecho y textos de lectura.
          </p>
        </header>

        <!-- El Container interior permite visualizar su ancho máximo. -->
        <Container size="sm" class="rounded-lg border border-slate-300 bg-slate-100 py-5">

          <p class="font-accent text-xs font-medium text-slate-600">
            SIZE: SM
          </p>

          <p class="mt-2 font-heading text-lg font-bold text-slate-900">
            Contenido estrecho
          </p>

          <p class="mt-1 font-body text-sm text-slate-600">
            Ancho máximo de 48rem.
          </p>

        </Container>

      </article>


      <!-- ==================================================
           02. SIZE MD
           ================================================== -->
      <article class="space-y-3">

        <header>
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            02 / Container size="md"
          </p>

          <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
            Medium · 56rem
          </h3>

          <p class="mt-1 font-body text-sm text-slate-600">
            max-w-4xl · Ideal para contenido de ancho intermedio.
          </p>
        </header>

        <Container size="md" class="rounded-lg border border-slate-300 bg-slate-100 py-5">

          <p class="font-accent text-xs font-medium text-slate-600">
            SIZE: MD
          </p>

          <p class="mt-2 font-heading text-lg font-bold text-slate-900">
            Contenido mediano
          </p>

          <p class="mt-1 font-body text-sm text-slate-600">
            Ancho máximo de 56rem.
          </p>

        </Container>

      </article>


      <!-- ==================================================
           03. SIZE LG
           ================================================== -->
      <article class="space-y-3">

        <header>
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            03 / Container size="lg"
          </p>

          <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
            Large · 64rem
          </h3>

          <p class="mt-1 font-body text-sm text-slate-600">
            max-w-5xl · Adecuado para secciones con mayor cantidad de contenido.
          </p>
        </header>

        <Container size="lg" class="rounded-lg border border-slate-300 bg-slate-100 py-5">

          <p class="font-accent text-xs font-medium text-slate-600">
            SIZE: LG
          </p>

          <p class="mt-2 font-heading text-lg font-bold text-slate-900">
            Contenido amplio
          </p>

          <p class="mt-1 font-body text-sm text-slate-600">
            Ancho máximo de 64rem.
          </p>

        </Container>

      </article>


      <!-- ==================================================
           04. SIZE XL
           ================================================== -->
      <article class="space-y-3">

        <header>
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            04 / Container size="xl"
          </p>

          <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
            Extra Large · 72rem
          </h3>

          <p class="mt-1 font-body text-sm text-slate-600">
            max-w-6xl · Para composiciones amplias y contenido en varias columnas.
          </p>
        </header>

        <Container size="xl" class="rounded-lg border border-slate-300 bg-slate-100 py-5">

          <p class="font-accent text-xs font-medium text-slate-600">
            SIZE: XL
          </p>

          <p class="mt-2 font-heading text-lg font-bold text-slate-900">
            Contenido extra amplio
          </p>

          <p class="mt-1 font-body text-sm text-slate-600">
            Ancho máximo de 72rem.
          </p>

        </Container>

      </article>


      <!-- ==================================================
           05. SIZE 2XL
           ================================================== -->
      <article class="space-y-3">

        <header>
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            05 / Container size="2xl"
          </p>

          <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
            Extra Extra Large · 80rem
          </h3>

          <p class="mt-1 font-body text-sm text-slate-600">
            max-w-7xl · Para contenido que necesita aprovechar un ancho mayor.
          </p>
        </header>

        <Container size="2xl" class="rounded-lg border border-slate-300 bg-slate-100 py-5">

          <p class="font-accent text-xs font-medium text-slate-600">
            SIZE: 2XL
          </p>

          <p class="mt-2 font-heading text-lg font-bold text-slate-900">
            Contenido muy amplio
          </p>

          <p class="mt-1 font-body text-sm text-slate-600">
            Ancho máximo de 80rem.
          </p>

        </Container>

      </article>


      <!-- ==================================================
           06. DEFAULT SIZE
           ================================================== -->
      <article class="space-y-3">

        <header>
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            06 / Container default
          </p>

          <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
            Tamaño predeterminado · 2XL
          </h3>

          <p class="mt-1 font-body text-sm text-slate-600">
            Si no se especifica la propiedad size, Container utiliza automáticamente 2xl.
          </p>
        </header>

        <!-- No especificamos size intencionalmente. -->
        <Container class="rounded-lg border border-slate-300 bg-slate-100 py-5">

          <p class="font-accent text-xs font-medium text-slate-600">
            DEFAULT: 2XL
          </p>

          <p class="mt-2 font-heading text-lg font-bold text-slate-900">
            Ancho máximo predeterminado
          </p>

          <p class="mt-1 font-body text-sm text-slate-600">
            Equivalente a utilizar size="2xl".
          </p>

        </Container>

      </article>

    </div>

    <!-- Pie de la demostración -->
    <footer class="border-t border-slate-300 pt-6">

      <p class="font-body text-sm text-slate-500">
        Container · Layout component · VTAV Frontend
      </p>

    </footer>

  </Container>

</section>