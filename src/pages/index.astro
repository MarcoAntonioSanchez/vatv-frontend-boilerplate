
---
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>VTAV Frontend</title>
	</head>
	<body class="min-h-screen bg-slate-950 text-white antialiased">
		<main class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-400">
				VTAV Frontend
			</p>

			<h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
				Boilerplate listo para crecer.
			</h1>

			<p class="max-w-xl text-base leading-7 text-slate-400">
				Astro, Tailwind CSS v4 y una base preparada para construir interfaces reutilizables.
			</p>

			<a
				href="https://docs.astro.build/"
				class="mt-2 inline-flex items-center rounded-lg bg-cyan-400 px-5 py-3 font-semibold text-slate-950 transition-colors hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-400"
			>
				Explorar Astro
			</a>
		</main>
	</body>
</html>
