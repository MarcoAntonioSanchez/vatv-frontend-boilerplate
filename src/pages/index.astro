---
import { ref } from "vue";

import { Icon } from "astro-icon/components";

import Button from "../components/ui/Button.vue";
import ButtonLoadingDemo from "../components/ui/ButtonLoadingDemo.vue";
import ButtonEventsDemo from "../components/ui/ButtonEventsDemo.vue";
import ButtonFormDemo from "../components/ui/ButtonFormDemo.vue";

import Layout from "../layouts/Layout.astro";

/*
 * IMPORTACIÓN DE COMPONENTES
 *
 * Container permite controlar el ancho máximo y la alineación
 * horizontal del contenido mediante sus propiedades size y width.
 */
import Container from "../components/layout/Container.astro";

/*
 * ESTILOS GLOBALES
 *
 * Incluye Tailwind CSS v4, tokens tipográficos y fuentes locales.
 */
import "../styles/global.css";
---

<Layout title="VTAV Frontend | Inicio">
  <!-- ============================================================
     SECCIÓN 01: PRESENTACIÓN DEL BOILERPLATE
     ============================================================ -->

  <section class="bg-slate-100">
    <Container class="space-y-8 py-16 sm:py-24">
      <!-- Encabezado de la demostración -->
      <header class="space-y-4">
        <p class="font-accent text-sm font-medium uppercase tracking-widest text-slate-600">
          V.T.A.V. - Frontend Boilerplate
        </p>

        <h1 class="font-heading text-4xl font-bold tracking-tight text-slate-950 text-balance sm:text-5xl">
          Construyendo una base reutilizable
        </h1>

        <p class="max-w-2xl font-body text-lg leading-relaxed text-slate-700">
          Una arquitectura frontend modular con Astro, Tailwind CSS y tokens de
          diseño para futuros proyectos web.
        </p>
      </header>

      <!-- Tarjeta de demostración -->
      <div class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="font-heading text-2xl font-bold text-slate-900">
          Nuestro primer Container
        </h2>

        <p class="mt-3 font-body leading-relaxed text-slate-600">
          El contenido está centrado y limitado por el ancho máximo del
          componente. El padding lateral se adapta al viewport.
        </p>

        <!-- Etiquetas técnicas -->
        <div class="mt-6 flex flex-wrap gap-3">
          <span class="rounded-full bg-slate-100 px-3 py-1 font-accent text-xs text-slate-700">
            Astro
          </span>

          <span class="rounded-full bg-slate-100 px-3 py-1 font-accent text-xs text-slate-700">
            Tailwind CSS v4
          </span>

          <span class="rounded-full bg-slate-100 px-3 py-1 font-accent text-xs text-slate-700">
            Design tokens
          </span>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============================================================
     SECCIÓN 02: SISTEMA TIPOGRÁFICO
     ============================================================ -->

  <section class="bg-slate-100">
    <Container class="space-y-8 py-16 sm:py-24">
      <!-- Encabezado de la demostración -->
      <header class="space-y-4">
        <p class="font-accent text-sm font-medium uppercase tracking-widest text-slate-600">
          VTAV Frontend / Design System
        </p>

        <h2 class="font-heading text-4xl font-bold tracking-tight text-slate-950 text-balance sm:text-5xl">
          Tres fuentes, una identidad.
        </h2>

        <p class="max-w-2xl font-body text-lg leading-relaxed text-slate-700">
          Una base tipográfica reutilizable para construir interfaces web
          consistentes, accesibles y fáciles de mantener.
        </p>
      </header>

      <!-- Tarjeta de demostración tipográfica -->
      <div class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
        <div class="grid gap-6 md:grid-cols-3">
          <!-- 01. HEADING / UBUNTU -->
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">
            <p class="mb-4 font-accent text-xs uppercase tracking-wider text-slate-600">
              01 / Heading
            </p>

            <h3 class="font-heading text-2xl font-bold text-slate-900">
              Ubuntu
            </h3>

            <p class="mt-3 font-body text-sm leading-6 text-slate-600">
              Medium y Bold para títulos, subtítulos y jerarquías visuales.
            </p>

            <p class="mt-6 font-heading font-medium text-slate-900">
              Medium 500
            </p>

            <p class="mt-2 font-heading font-bold text-slate-900">Bold 700</p>
          </article>

          <!-- 02. BODY / INTER -->
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">
            <p class="mb-4 font-accent text-xs uppercase tracking-wider text-slate-600">
              02 / Body
            </p>

            <h3 class="font-body text-2xl font-bold text-slate-900">
              Inter Variable
            </h3>

            <p class="mt-3 font-body text-sm leading-6 text-slate-600">
              Una familia variable para párrafos, descripciones y contenido
              general.
            </p>

            <p class="mt-6 font-body font-normal text-slate-900">Regular 400</p>

            <p class="mt-2 font-body font-medium text-slate-900">Medium 500</p>

            <p class="mt-2 font-body font-bold text-slate-900">Bold 700</p>
          </article>

          <!-- 03. ACCENT / JETBRAINS MONO -->
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">
            <p class="mb-4 font-accent text-xs uppercase tracking-wider text-slate-600">
              03 / Accent
            </p>

            <h3 class="font-accent text-xl font-bold text-slate-900">
              JetBrains Mono
            </h3>

            <p class="mt-3 font-body text-sm leading-6 text-slate-600">
              Una fuente monoespaciada para etiquetas, metadatos y detalles
              técnicos.
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              <span class="rounded-md border border-slate-300 bg-white px-3 py-1 font-accent text-xs text-slate-700">
                BETA
              </span>

              <span class="rounded-md border border-slate-300 bg-white px-3 py-1 font-accent text-xs text-slate-700">
                v1.0.0
              </span>
            </div>

            <p class="mt-4 font-accent text-sm text-slate-700">
              0123456789 / &#123; &#125; / &lt;/&gt;
            </p>
          </article>
        </div>

        <!-- Pie de la demostración -->
        <footer class="mt-8 border-t border-slate-200 pt-6">
          <p class="font-body text-sm text-slate-500">
            Prueba tipográfica · Astro + Tailwind CSS v4
          </p>
        </footer>
      </div>
    </Container>
  </section>

  <!-- ============================================================
     SECCIÓN 03: CONTAINER / SISTEMA DE ANCHOS
     ============================================================ -->

  <section class="bg-slate-100">
    <!--
    Esta sección utiliza el modo full-width.
    Su contenido interior podrá alcanzar los anchos configurados
    sin quedar limitado por un Container padre boxed.
  -->
    <Container width="full" class="space-y-8 py-16 sm:py-24">
      <!-- Encabezado de la demostración -->
      <header class="mx-auto w-full max-w-7xl space-y-4 px-4 sm:px-6 lg:px-8">
        <p class="font-accent text-sm font-medium uppercase tracking-widest text-slate-600">
          VTAV Frontend / Layout Components
        </p>

        <h2 class="font-heading text-4xl font-bold tracking-tight text-slate-950 text-balance sm:text-5xl">
          Un contenedor, múltiples posibilidades.
        </h2>

        <p class="max-w-2xl font-body text-lg leading-relaxed text-slate-700">
          Container permite establecer diferentes anchos máximos para organizar
          el contenido de cada proyecto, manteniendo el centrado y el padding
          responsive.
        </p>
      </header>

      <!-- ========================================================
         DEMOSTRACIONES BOXED
         ======================================================== -->

      <div class="space-y-8">
        <!-- 01. SIZE SM -->
        <article class="space-y-3">
          <Container width="full" class="space-y-3">
            <header>
              <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
                01 / Container size="sm"
              </p>

              <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
                Small · 48rem
              </h3>

              <p class="mt-1 font-body text-sm text-slate-600">
                max-w-3xl · Ideal para contenido estrecho y textos de lectura.
              </p>
            </header>
          </Container>

          <Container
            size="sm"
            class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm"
          >
            <p class="font-accent text-xs font-medium text-slate-600">
              SIZE: SM
            </p>

            <p class="mt-2 font-heading text-lg font-bold text-slate-900">
              Contenido estrecho
            </p>

            <p class="mt-1 font-body text-sm text-slate-600">
              Ancho máximo de 48rem.
            </p>
          </Container>
        </article>

        <!-- 02. SIZE MD -->
        <article class="space-y-3">
          <Container width="full" class="space-y-3">
            <header>
              <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
                02 / Container size="md"
              </p>

              <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
                Medium · 56rem
              </h3>

              <p class="mt-1 font-body text-sm text-slate-600">
                max-w-4xl · Ideal para contenido de ancho intermedio.
              </p>
            </header>
          </Container>

          <Container
            size="md"
            class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm"
          >
            <p class="font-accent text-xs font-medium text-slate-600">
              SIZE: MD
            </p>

            <p class="mt-2 font-heading text-lg font-bold text-slate-900">
              Contenido mediano
            </p>

            <p class="mt-1 font-body text-sm text-slate-600">
              Ancho máximo de 56rem.
            </p>
          </Container>
        </article>

        <!-- 03. SIZE LG -->
        <article class="space-y-3">
          <Container width="full" class="space-y-3">
            <header>
              <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
                03 / Container size="lg"
              </p>

              <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
                Large · 64rem
              </h3>

              <p class="mt-1 font-body text-sm text-slate-600">
                max-w-5xl · Adecuado para secciones con mayor cantidad de
                contenido.
              </p>
            </header>
          </Container>

          <Container
            size="lg"
            class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm"
          >
            <p class="font-accent text-xs font-medium text-slate-600">
              SIZE: LG
            </p>

            <p class="mt-2 font-heading text-lg font-bold text-slate-900">
              Contenido amplio
            </p>

            <p class="mt-1 font-body text-sm text-slate-600">
              Ancho máximo de 64rem.
            </p>
          </Container>
        </article>

        <!-- 04. SIZE XL -->
        <article class="space-y-3">
          <Container width="full" class="space-y-3">
            <header>
              <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
                04 / Container size="xl"
              </p>

              <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
                Extra Large · 72rem
              </h3>

              <p class="mt-1 font-body text-sm text-slate-600">
                max-w-6xl · Para composiciones amplias y contenido en varias
                columnas.
              </p>
            </header>
          </Container>

          <Container
            size="xl"
            class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm"
          >
            <p class="font-accent text-xs font-medium text-slate-600">
              SIZE: XL
            </p>

            <p class="mt-2 font-heading text-lg font-bold text-slate-900">
              Contenido extra amplio
            </p>

            <p class="mt-1 font-body text-sm text-slate-600">
              Ancho máximo de 72rem.
            </p>
          </Container>
        </article>

        <!-- 05. SIZE 2XL -->
        <article class="space-y-3">
          <Container width="full" class="space-y-3">
            <header>
              <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
                05 / Container size="2xl"
              </p>

              <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
                Extra Extra Large · 80rem
              </h3>

              <p class="mt-1 font-body text-sm text-slate-600">
                max-w-7xl · Para contenido que necesita aprovechar un ancho
                mayor.
              </p>
            </header>
          </Container>

          <Container
            size="2xl"
            class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm"
          >
            <p class="font-accent text-xs font-medium text-slate-600">
              SIZE: 2XL
            </p>

            <p class="mt-2 font-heading text-lg font-bold text-slate-900">
              Contenido muy amplio
            </p>

            <p class="mt-1 font-body text-sm text-slate-600">
              Ancho máximo de 80rem.
            </p>
          </Container>
        </article>

        <!-- 06. DEFAULT SIZE -->
        <article class="space-y-3">
          <Container width="full" class="space-y-3">
            <header>
              <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
                06 / Container default
              </p>

              <h3 class="mt-1 font-heading text-xl font-bold text-slate-900">
                Tamaño predeterminado · 2XL
              </h3>

              <p class="mt-1 font-body text-sm text-slate-600">
                Cuando no especificamos size, Container utiliza automáticamente
                2xl.
              </p>
            </header>
          </Container>

          <!-- No especificamos size intencionalmente. -->
          <Container class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm">
            <p class="font-accent text-xs font-medium text-slate-600">
              DEFAULT: 2XL
            </p>

            <p class="mt-2 font-heading text-lg font-bold text-slate-900">
              Ancho máximo predeterminado
            </p>

            <p class="mt-1 font-body text-sm text-slate-600">
              Equivalente a utilizar size="2xl".
            </p>
          </Container>
        </article>
      </div>

      <!-- ========================================================
         DEMOSTRACIÓN FULL-WIDTH
         ======================================================== -->

      <div class="space-y-6 border-t border-slate-300 pt-8">
        <header class="space-y-3 px-4 sm:px-6 lg:px-8">
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            07 / Container width="full"
          </p>

          <h3 class="font-heading text-2xl font-bold text-slate-900">
            Full-width · Ancho completo
          </h3>

          <p class="max-w-2xl font-body leading-relaxed text-slate-600">
            El modo full elimina el ancho máximo y permite que el contenedor
            ocupe todo el espacio disponible de su elemento padre.
          </p>
        </header>

        <!--
        Este Container ocupa todo el ancho disponible.
        El fondo permite identificar visualmente sus límites.
      -->
        <Container width="full" class="border-y border-slate-300 bg-white py-8">
          <p class="font-accent text-xs font-medium text-slate-600">
            WIDTH: FULL
          </p>

          <h4 class="mt-2 font-heading text-xl font-bold text-slate-900">
            Este contenido ocupa todo el ancho disponible.
          </h4>

          <p class="mt-2 font-body text-sm text-slate-600">
            Conserva el padding horizontal responsive, pero no tiene max-width.
          </p>
        </Container>
      </div>

      <!-- ========================================================
         DEMOSTRACIÓN COMBINADA: FULL-WIDTH + BOXED
         ======================================================== -->

      <div class="space-y-6 border-t border-slate-300 pt-8">
        <header class="space-y-3 px-4 sm:px-6 lg:px-8">
          <p class="font-accent text-xs uppercase tracking-wider text-slate-600">
            08 / Full-width section + boxed content
          </p>

          <h3 class="font-heading text-2xl font-bold text-slate-900">
            Una sección amplia con contenido centrado.
          </h3>

          <p class="max-w-2xl font-body leading-relaxed text-slate-600">
            Una composición habitual en proyectos web: el fondo ocupa todo el
            ancho de la pantalla, mientras que el contenido mantiene una anchura
            máxima.
          </p>
        </header>

        <!-- La sección ocupa todo el ancho. -->
        <section class="w-full bg-slate-900 py-10">
          <!-- El contenido interior se mantiene boxed. -->
          <Container size="xl">
            <p class="font-accent text-xs uppercase tracking-wider text-slate-400">
              FULL-WIDTH SECTION / BOXED CONTENT
            </p>

            <h4 class="mt-3 font-heading text-2xl font-bold text-white sm:text-3xl">
              Fondo de extremo a extremo.
            </h4>

            <p class="mt-3 max-w-2xl font-body leading-relaxed text-slate-300">
              El fondo oscuro se extiende a lo largo de la pantalla, pero el
              contenido conserva una alineación central y un ancho máximo de
              72rem.
            </p>
          </Container>
        </section>
      </div>

      <!-- Pie de la demostración -->
      <footer class="border-t border-slate-300 pt-6">
        <p class="font-body text-sm text-slate-500">
          Container · Boxed & Full-width · VTAV Frontend
        </p>
      </footer>
    </Container>
  </section>

  <!-- ============================================================
     SECTION 04: ICONOGRAPHY
     ============================================================ -->

  <section class="w-full bg-slate-100 py-16">
    <Container>
      <!-- Encabezado de sección -->
      <div class="mb-10">
        <span class="font-accent text-sm text-slate-500">
          UI COMPONENTS / ICONS
        </span>

        <h2 class="mt-2 text-3xl font-heading font-bold text-slate-900">
          Una iconografía consistente
        </h2>

        <p class="mt-3 max-w-2xl text-slate-600">
          Iconify integra iconos de interfaz y marcas reconocidas mediante SVG,
          con estilos controlados por Tailwind CSS.
        </p>
      </div>

      <!-- 01. Tamaño pequeño -->
      <div class="mb-8 rounded-xl bg-white p-6">
        <h3 class="mb-2 font-heading font-bold text-slate-900">Small · 16px</h3>

        <p class="mb-5 text-sm text-slate-500">
          Iconos compactos para elementos secundarios, etiquetas y acciones
          pequeñas.
        </p>

        <div class="flex items-center gap-6">
          <Icon name="tabler:arrow-right" class="size-4" />
          <Icon name="tabler:search" class="size-4" />
          <Icon name="tabler:heart" class="size-4" />
          <Icon name="simple-icons:github" class="size-4" />
        </div>
      </div>

      <!-- 02. Tamaño mediano -->
      <div class="mb-8 rounded-xl bg-white p-6">
        <h3 class="mb-2 font-heading font-bold text-slate-900">
          Medium · 24px
        </h3>

        <p class="mb-5 text-sm text-slate-500">
          Tamaño estándar para botones, navegación y controles de interfaz.
        </p>

        <div class="flex items-center gap-6">
          <Icon name="tabler:arrow-right" class="size-6" />
          <Icon name="tabler:search" class="size-6" />
          <Icon name="tabler:heart" class="size-6" />
          <Icon name="simple-icons:github" class="size-6" />
        </div>
      </div>

      <!-- 03. Tamaño grande -->
      <div class="mb-8 rounded-xl bg-white p-6">
        <h3 class="mb-2 font-heading font-bold text-slate-900">Large · 32px</h3>

        <p class="mb-5 text-sm text-slate-500">
          Para elementos destacados, acciones principales y bloques visuales.
        </p>

        <div class="flex items-center gap-6">
          <Icon name="tabler:arrow-right" class="size-8" />
          <Icon name="tabler:search" class="size-8" />
          <Icon name="tabler:heart" class="size-8" />
          <Icon name="simple-icons:github" class="size-8" />
        </div>
      </div>

      <!-- 04. Interacción: color y hover -->
      <div class="rounded-xl bg-slate-900 p-6">
        <h3 class="mb-2 font-heading font-bold text-white">Color & Hover</h3>

        <p class="mb-5 text-sm text-slate-300">
          Personalización visual mediante clases Tailwind y transiciones.
        </p>

        <div class="flex items-center gap-8">
          <Icon
            name="tabler:heart"
            class="size-8 text-rose-400 transition-transform duration-300 hover:scale-125 hover:text-rose-300"
          />

          <Icon
            name="tabler:arrow-right"
            class="size-8 text-blue-400 transition-transform duration-300 hover:translate-x-2 hover:text-blue-300"
          />

          <Icon
            name="simple-icons:github"
            class="size-8 text-slate-300 transition-colors duration-300 hover:text-white"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- =====================================================
     SECTION 05: COLOR TOKENS
====================================================== -->
  <section class="w-full bg-background py-16">
    <Container>
      <!-- Encabezado -->
      <div class="mb-10">
        <span class="font-accent text-sm text-text-muted">
          DESIGN SYSTEM / COLOR TOKENS
        </span>

        <h2 class="mt-2 text-3xl font-heading font-bold text-text">
          Una identidad visual adaptable
        </h2>

        <p class="mt-3 max-w-2xl text-text-muted">
          Tokens semánticos que permiten personalizar la identidad visual de
          cada proyecto y mantener consistencia en sus componentes.
        </p>
      </div>

      <!-- 01. Brand colors -->
      <div class="mb-8 rounded-xl border border-border bg-surface p-6">
        <h3 class="mb-2 font-heading font-bold text-text">Brand colors</h3>

        <p class="mb-5 text-sm text-text-muted">
          Colores principales de identidad y acciones.
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <div class="h-20 rounded-lg bg-primary"></div>
            <p class="mt-2 font-medium text-text">Primary</p>
            <p class="text-sm text-text-muted">bg-primary</p>
          </div>

          <div>
            <div class="h-20 rounded-lg bg-secondary"></div>
            <p class="mt-2 font-medium text-text">Secondary</p>
            <p class="text-sm text-text-muted">bg-secondary</p>
          </div>

          <div>
            <div class="h-20 rounded-lg bg-accent"></div>
            <p class="mt-2 font-medium text-text">Accent</p>
            <p class="text-sm text-text-muted">bg-accent</p>
          </div>
        </div>
      </div>

      <!-- 02. Surface colors -->
      <div class="mb-8 rounded-xl border border-border bg-surface p-6">
        <h3 class="mb-2 font-heading font-bold text-text">
          Surface & Background
        </h3>

        <p class="mb-5 text-sm text-text-muted">
          Superficies para páginas, tarjetas y elementos de interfaz.
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-lg border border-border bg-background p-5">
            <p class="font-medium text-text">Background</p>
            <p class="mt-1 text-sm text-text-muted">bg-background</p>
          </div>

          <div class="rounded-lg border border-border bg-surface p-5">
            <p class="font-medium text-text">Surface</p>
            <p class="mt-1 text-sm text-text-muted">bg-surface</p>
          </div>

          <div class="rounded-lg border border-border bg-surface-muted p-5">
            <p class="font-medium text-text">Surface Muted</p>
            <p class="mt-1 text-sm text-text-muted">bg-surface-muted</p>
          </div>
        </div>
      </div>

      <!-- 03. Text colors -->
