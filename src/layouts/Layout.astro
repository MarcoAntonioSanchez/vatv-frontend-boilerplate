---
/*
 * PROPIEDADES DEL LAYOUT
 *
 * Permite personalizar el título de cada página.
 */
interface Props {
  title?: string;
}

const { title = "VTAV Frontend" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="VTAV Frontend Boilerplate" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>